# HandshakeOS kernel fragment for the Anbernic RG35XX 2024 (Allwinner H700)
# Apply on top of an arm64 defconfig from mainline Linux >= 6.12
# (6.12 is the floor because CONFIG_SCHED_CLASS_EXT arrives there).
# ROCKNIX was on kernel 7.2 as of 2026-08-17; prefer a current stable
# of that vintage once you are ready to fetch sources.
#
# This fragment does not stand alone. Start from `make ARCH=arm64 defconfig`
# (or a distro config), then merge these symbols.

# Timing: preemptible kernel, high-res timers, full dynticks for a reserved CPU
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_COMMON=y
CONFIG_HZ_1000=y

# sched_ext experiment (Phase 2). Harmless in Phase 1 if unused.
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y

# Display and GPU: DRM/KMS + Panfrost (Mali G31). fbdev as a fallback.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_PANFROST=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Input, battery, LEDs, MMC, USB (OTG host needs the ROCKNIX DT patch)
CONFIG_INPUT=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_EVDEV=y
CONFIG_GPIO_CDEV=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_CLASS=y
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_USB=y
CONFIG_USB_OTG=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_STORAGE=y
CONFIG_USB_NET_DRIVERS=y

# Power: AXP717
# CHARGER_AXP20X and BATTERY_AXP20X both "depends on AXP20X_ADC && IIO".
# The 7.3.5 first-boot kernel had AXP20X_ADC unset, so Kconfig silently
# dropped both (HandshakeOS showed "AXP717 sysfs pending"), and the
# axp717 usb-power cell defers forever without its vbus IIO channels.
# AXP20X_PEK is the AXP717 power-key cell (KEY_POWER on evdev).
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_IIO=y
CONFIG_AXP20X_ADC=y
CONFIG_CHARGER_AXP20X=y
CONFIG_BATTERY_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_AXP20X_PEK=y

# Serial console: ttyS0,115200
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SUNXI_WATCHDOG=y

# Filesystems for a small root
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Suggested cmdline once NO_HZ_FULL is on (four cores; reserve CPU 3
# for later handshake experiments, do not enable until measured):
#   isolcpus=nohz,domain,managed_irq,3 nohz_full=3 rcu_nocbs=3
#   console=ttyS0,115200 earlycon

# Panel and backlight (RG35XX 2024 640x480 NV3052C over GPIO-SPI)
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_GPIO=y
CONFIG_SPI_BITBANG=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_NEWVISION_NV3052C=y
CONFIG_DRM_PANEL_MIPI_DBI=n
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_GPIO_CDEV=y

# Built-in (no modules) so handshake-init can light /dev/fb0 without an extra rootfs
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=n
CONFIG_DRM_PANEL_MIPI=y
CONFIG_PWM_SUN8I=y
CONFIG_PWM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN50I_PLANES=y
