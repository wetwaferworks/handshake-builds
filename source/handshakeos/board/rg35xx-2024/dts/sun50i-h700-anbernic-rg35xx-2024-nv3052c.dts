			phandle = <0x40>;
		};

		pinctrl@7022000 {
			compatible = "allwinner,sun50i-h616-r-pinctrl";
			reg = <0x7022000 0x400>;
			clocks = <0x3d 0x02 0x15 0x14 0x00>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <0x03>;

			r-i2c-pins {
				pins = "PL0", "PL1";
				function = "s_i2c";
				phandle = <0x3f>;
			};

			r-rsb-pins {
				pins = "PL0", "PL1";
				function = "s_rsb";
				phandle = <0x43>;
			};
		};

		ir@7040000 {
			compatible = "allwinner,sun50i-h616-ir", "allwinner,sun6i-a31-ir";
			reg = <0x7040000 0x400>;
			interrupts = <0x00 0x6a 0x04>;
			clocks = <0x3d 0x09 0x3d 0x0b>;
			clock-names = "apb", "ir";
			resets = <0x3d 0x05>;
			pinctrl-names = "default";
			pinctrl-0 = <0x3e>;
			status = "disabled";
		};

		i2c@7081400 {
			compatible = "allwinner,sun50i-h616-i2c", "allwinner,sun8i-v536-i2c", "allwinner,sun6i-a31-i2c";
			reg = <0x7081400 0x400>;
			interrupts = <0x00 0x69 0x04>;
			clocks = <0x3d 0x08>;
			dmas = <0x18 0x30 0x18 0x30>;
			dma-names = "rx", "tx";
			resets = <0x3d 0x04>;
			pinctrl-names = "default";
			pinctrl-0 = <0x3f>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			pmic@34 {
				compatible = "x-powers,axp717";
				reg = <0x34>;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupt-parent = <0x40>;
				interrupts = <0x00 0x08>;
				vin1-supply = <0x41>;
				vin2-supply = <0x41>;
				vin3-supply = <0x41>;
				vin4-supply = <0x41>;

				adc {
					compatible = "x-powers,axp717-adc";
					#io-channel-cells = <0x01>;
				};

				battery-power {
					compatible = "x-powers,axp717-battery-power-supply";
					monitored-battery = <0x42>;
					x-powers,no-thermistor;
				};

				regulators {

					dcdc1 {
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0x11b340>;
						regulator-name = "vdd-cpu";
						phandle = <0x05>;
					};

					dcdc2 {
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0xea600>;
						regulator-name = "vdd-gpu-sys";
						phandle = <0x12>;
					};

					dcdc3 {
						regulator-always-on;
						regulator-min-microvolt = <0x10c8e0>;
						regulator-max-microvolt = <0x10c8e0>;
						regulator-name = "vdd-dram";
					};

					aldo1 {
					};

					aldo2 {
					};

					aldo3 {
					};

					aldo4 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "avcc";
						phandle = <0x17>;
					};

					bldo1 {
					};

					bldo2 {
						regulator-always-on;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "vcc-pll";
					};

					bldo3 {
					};

					bldo4 {
					};

					cldo1 {
						regulator-always-on;
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-spkr-amp";
					};

					cldo2 {
					};

					cldo3 {
						regulator-always-on;
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-io";
						phandle = <0x16>;
					};

					cldo4 {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-wifi";
						phandle = <0x1c>;
					};

					boost {
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x4f5880>;
						regulator-name = "boost";
						phandle = <0x49>;
					};

					cpusldo {
						regulator-always-on;
						regulator-boot-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0xdbba0>;
					};
				};

				usb-power {
					compatible = "x-powers,axp717-usb-power-supply";
					input-current-limit-microamp = <0x16e360>;
					phandle = <0x29>;
				};
			};
		};

		rsb@7083000 {
			compatible = "allwinner,sun50i-h616-rsb", "allwinner,sun8i-a23-rsb";
			reg = <0x7083000 0x400>;
			interrupts = <0x00 0x6d 0x04>;
			clocks = <0x3d 0x0d>;
			clock-frequency = <0x2dc6c0>;
			resets = <0x3d 0x07>;
			pinctrl-names = "default";
			pinctrl-0 = <0x43>;
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x1f4>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x44 0x02>;
			sustainable-power = <0x3e8>;

			trips {

				cpu-trip-0 {
					temperature = <0xea60>;
					type = "passive";
					hysteresis = <0x00>;
				};

				cpu-trip-1 {
					temperature = <0x11170>;
					type = "passive";
					hysteresis = <0x00>;
				};

				cpu-trip-2 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0x1f4>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x44 0x00>;
			sustainable-power = <0x44c>;

			trips {

				gpu-trip-0 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
				};
			};
		};

		ve-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x44 0x01>;

			trips {

				ve-trip-0 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
				};
			};
		};

		ddr-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x44 0x03>;

			trips {

				ddr-trip-0 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
				};
			};
		};
	};

	opp-table-cpu {
		compatible = "allwinner,sun50i-h616-operating-points";
		nvmem-cells = <0x45>;
		opp-shared;
		phandle = <0x04>;

		opp-480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			opp-microvolt = <0xdbba0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x3f>;
			opp-suspend;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xdbba0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x12>;
		};

		opp-720000000 {
			opp-hz = <0x00 0x2aea5400>;
			opp-microvolt = <0xdbba0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x2d>;
		};

		opp-792000000 {
			opp-hz = <0x00 0x2f34f600>;
			opp-microvolt-speed1 = <0xdbba0>;
			opp-microvolt-speed4 = <0xe57e0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x12>;
		};

		opp-936000000 {
			opp-hz = <0x00 0x37ca3a00>;
			opp-microvolt = <0xdbba0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x0d>;
		};

		opp-1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt-speed0 = <0xe7ef0>;
			opp-microvolt-speed1 = <0xe57e0>;
			opp-microvolt-speed2 = <0xe7ef0>;
			opp-microvolt-speed3 = <0xe7ef0>;
			opp-microvolt-speed4 = <0xf9060>;
			opp-microvolt-speed5 = <0xdbba0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x3f>;
		};

		opp-1104000000 {
			opp-hz = <0x00 0x41cdb400>;
			opp-microvolt-speed0 = <0xf4240>;
			opp-microvolt-speed2 = <0xf4240>;
			opp-microvolt-speed3 = <0xf4240>;
			opp-microvolt-speed5 = <0xe7ef0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x2d>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt-speed0 = <0x100590>;
			opp-microvolt-speed1 = <0xf9060>;
			opp-microvolt-speed2 = <0x100590>;
			opp-microvolt-speed3 = <0x100590>;
			opp-microvolt-speed4 = <0x10c8e0>;
			opp-microvolt-speed5 = <0xf9060>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x3f>;
		};

		opp-1320000000 {
			opp-hz = <0x00 0x4ead9a00>;
			opp-microvolt = <0x10c8e0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x3d>;
		};

		opp-1416000000 {
			opp-hz = <0x00 0x54667200>;
			opp-microvolt = <0x10c8e0>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x2d>;
		};

		opp-1512000000 {
			opp-hz = <0x00 0x5a1f4a00>;
			opp-microvolt-speed1 = <0x10c8e0>;
			opp-microvolt-speed3 = <0x10c8e0>;
			opp-microvolt-speed5 = <0x11b340>;
			clock-latency-ns = <0x3b9b0>;
			opp-supported-hw = <0x2a>;
			turbo-mode;
		};
	};

	aliases {
		mmc0 = "/soc/mmc@4020000";
		mmc1 = "/soc/mmc@4022000";
		mmc2 = "/soc/mmc@4021000";
		serial0 = "/soc/serial@5000000";
		serial1 = "/soc/serial@5001400";
	};

	backlight {
		compatible = "pwm-backlight";
		pwms = <0x46 0x00 0x9c40 0x00>;
		pinctrl-0 = <0x47>;
		pinctrl-names = "default";
		phandle = <0x4a>;
	};

	battery {
		compatible = "simple-battery";
		constant-charge-current-max-microamp = <0xfa000>;
		voltage-max-design-microvolt = <0x401640>;
		phandle = <0x42>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	connector {
		compatible = "hdmi-connector";
		type = "d";

		port {

			endpoint {
				remote-endpoint = <0x48>;
				phandle = <0x2d>;
			};
		};
	};

	gpio-keys-gamepad {
		compatible = "gpio-keys";

		button-a {
			label = "Action-Pad A";
			gpios = <0x1a 0x00 0x00 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x131>;
		};

		button-b {
			label = "Action-Pad B";
			gpios = <0x1a 0x00 0x01 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x130>;
		};

		button-down {
			label = "D-Pad Down";
			gpios = <0x1a 0x04 0x00 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x221>;
		};

		button-l1 {
			label = "Key L1";
			gpios = <0x1a 0x00 0x0a 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x136>;
		};

		button-l2 {
			label = "Key L2";
			gpios = <0x1a 0x00 0x0b 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x138>;
		};

		button-left {
			label = "D-Pad left";
			gpios = <0x1a 0x00 0x08 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x222>;
		};

		button-menu {
			label = "Key Menu";
			gpios = <0x1a 0x04 0x03 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x13c>;
		};

		button-r1 {
			label = "Key R1";
			gpios = <0x1a 0x00 0x0c 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x137>;
		};

		button-r2 {
			label = "Key R2";
			gpios = <0x1a 0x00 0x07 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x139>;
		};

		button-right {
			label = "D-Pad Right";
			gpios = <0x1a 0x00 0x09 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x223>;
		};

		button-select {
			label = "Key Select";
			gpios = <0x1a 0x00 0x05 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x13a>;
		};

		button-start {
			label = "Key Start";
			gpios = <0x1a 0x00 0x04 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x13b>;
		};

		button-up {
			label = "D-Pad Up";
			gpios = <0x1a 0x00 0x06 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x220>;
		};

		button-x {
			label = "Action-Pad X";
			gpios = <0x1a 0x00 0x03 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x133>;
		};

		button-y {
			label = "Action Pad Y";
			gpios = <0x1a 0x00 0x02 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x134>;
		};
	};

	gpio-keys-volume {
		compatible = "gpio-keys";
		autorepeat;

		button-vol-up {
			label = "Key Volume Up";
			gpios = <0x1a 0x04 0x01 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x73>;
		};

		button-vol-down {
			label = "Key Volume Down";
			gpios = <0x1a 0x04 0x02 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x72>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			function = "power";
			color = <0x02>;
			gpios = <0x1a 0x08 0x0c 0x00>;
			default-state = "on";
		};

		led-1 {
			function = "status";
			color = <0x01>;
			gpios = <0x1a 0x08 0x0b 0x00>;
		};
	};

	regulator-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0x41>;
	};

	regulator-vcc3v3-mmc2 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x1a 0x04 0x04 0x00>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-name = "vcc3v3-mmc2";
		regulator-always-on;
		phandle = <0x1e>;
	};

	regulator-usb0-vbus {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x1a 0x08 0x10 0x00>;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-name = "usb0-vbus";
		vin-supply = <0x49>;
		phandle = <0x2a>;
	};

	regulator-gpio-lcd-vdd {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-name = "vdd-lcd";
		gpio = <0x1a 0x08 0x0f 0x00>;
		enable-active-high;
		phandle = <0x4b>;
	};

	spi {
		compatible = "spi-gpio";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		sck-gpios = <0x1a 0x08 0x09 0x00>;
		mosi-gpios = <0x1a 0x08 0x0a 0x00>;
		cs-gpios = <0x1a 0x08 0x08 0x00>;
		num-chipselects = <0x01>;

		panel@0 {
			compatible = "anbernic,rg35xx-plus-panel";
			reg = <0x00>;
			spi-max-frequency = <0x2faf08>;
			spi-3wire;
			reset-gpios = <0x1a 0x08 0x0e 0x01>;
			backlight = <0x4a>;
			power-supply = <0x4b>;
			pinctrl-0 = <0x4c>;
			pinctrl-names = "default";

			port {

				endpoint {
					remote-endpoint = <0x4d>;
					phandle = <0x38>;
				};
			};
		};
	};

	opp-table-1 {
		compatible = "operating-points-v2";
		phandle = <0x13>;

		opp-420000000 {
			opp-hz = <0x00 0x1908b100>;
			opp-microvolt = <0xdbba0>;
		};

		opp-456000000 {
			opp-hz = <0x00 0x1b2e0200>;
			opp-microvolt = <0xdbba0>;
		};

		opp-504000000 {
			opp-hz = <0x00 0x1e0a6e00>;
			opp-microvolt = <0xdbba0>;
		};

		opp-552000000 {
			opp-hz = <0x00 0x20e6da00>;
			opp-microvolt = <0xdbba0>;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xdbba0>;
		};

		opp-648000000 {
			opp-hz = <0x00 0x269fb200>;
			opp-microvolt = <0xea600>;
		};
	};
};
